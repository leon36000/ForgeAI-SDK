{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://forgeai.local/schemas/task-envelope-v0.1.1.json","title":"ForgeAI TaskEnvelope v0.1.1","type":"object","additionalProperties":false,"required":["schema_version","task_id","title","objective","role","mode","risk","task_kind","base_commit","workspace","allowed_paths","denied_paths","allowed_bash_commands","required_test_commands","allowed_network_hosts","allowed_mcp_tools","acceptance_criteria","execution","delegation","evidence_dir","created_at","expires_at","metadata"],"properties":{"schema_version":{"const":"forgeai.task-envelope.v0.1.1"},"task_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,63}$"},"title":{"type":"string","minLength":1},"objective":{"type":"string","minLength":1},"role":{"enum":["orchestrator","writer","reviewer","auditor","security","verifier"]},"mode":{"enum":["CONSULT","AUDIT","REVIEW","EXECUTE"]},"risk":{"enum":["R0","R1","R2","R3"]},"task_kind":{"type":"string","minLength":1},"base_commit":{"type":"string","pattern":"^[0-9a-fA-F]{7,64}$"},"workspace":{"type":"string","minLength":1},"allowed_paths":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"denied_paths":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"allowed_bash_commands":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"required_test_commands":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"allowed_network_hosts":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"acceptance_criteria":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","statement","verification"],"properties":{"id":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]{1,31}$"},"statement":{"type":"string","minLength":1},"verification":{"type":"string","minLength":1}}}},"execution":{"type":"object","additionalProperties":false,"required":["harness","qualified","sandbox_required","sandbox_verified"],"properties":{"harness":{"type":"string","minLength":1},"qualified":{"type":"boolean"},"sandbox_required":{"type":"boolean"},"sandbox_verified":{"type":"boolean"}}},"delegation":{"type":"object","additionalProperties":false,"required":["agent_depth","max_parallel_agents","allow_nested_agents"],"properties":{"agent_depth":{"type":"integer","minimum":0,"maximum":1},"max_parallel_agents":{"type":"integer","minimum":1,"maximum":4},"allow_nested_agents":{"const":false}}},"evidence_dir":{"type":"string","minLength":1},"created_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"metadata":{"type":"object"},"allowed_mcp_tools":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^mcp__[A-Za-z0-9_-]+__[A-Za-z0-9_-]+$"}}}}
