{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeai.local/schemas/advisory-request-v0.3.0-alpha.1.schema.json",
  "title": "ForgeAI advisory request 0.3.0-alpha.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "mode", "capability", "objective", "context", "max_output_tokens", "max_total_tokens", "max_cost_usd", "timeout_ms", "allow_fallback"],
  "properties": {
    "schema_version": { "const": "forgeai.advisory-request.v0.3.0-alpha.1" },
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "mode": { "enum": ["CONSULT", "AUDIT", "REVIEW", "JUDGE"] },
    "capability": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "objective": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "context": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "content"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
          "kind": { "enum": ["text", "diff", "code", "test", "log", "requirement", "evidence"] },
          "content": { "type": "string", "maxLength": 131072 },
          "path": { "type": "string", "maxLength": 1024 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "max_total_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "max_cost_usd": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
    "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 900000 },
    "allow_fallback": { "type": "boolean" },
    "metadata": { "type": "object", "maxProperties": 32, "additionalProperties": { "type": ["string", "number", "boolean", "null"] } }
  }
}
