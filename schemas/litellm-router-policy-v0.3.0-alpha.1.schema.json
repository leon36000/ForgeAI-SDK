{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeai.local/schemas/litellm-router-policy-v0.3.0-alpha.1.schema.json",
  "title": "ForgeAI LiteLLM router policy 0.3.0-alpha.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "endpoint_env", "api_key_env", "routes", "capability_routes"],
  "properties": {
    "schema_version": { "const": "forgeai.litellm-router-policy.v0.3.0-alpha.1" },
    "policy_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "endpoint_env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,127}$" },
    "api_key_env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,127}$" },
    "routes": { "type": "array", "minItems": 1, "maxItems": 64 },
    "capability_routes": { "type": "object", "minProperties": 1, "maxProperties": 128 }
  }
}
