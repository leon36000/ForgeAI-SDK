{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeai.local/schemas/reviewer-result-v0.2.0-alpha.1.schema.json",
  "title": "ForgeAI Reviewer Result v0.2.0-alpha.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verdict", "summary", "final_commit", "findings"],
  "properties": {
    "schema_version": { "const": "forgeai.reviewer-result.v0.2.0-alpha.1" },
    "verdict": { "enum": ["PASS", "BLOCKED"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "final_commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "findings": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "status", "code", "message", "resolution"],
      "properties": {
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "status": { "enum": ["OPEN", "RESOLVED", "ACCEPTED_RISK", "REJECTED"] },
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "message": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "resolution": { "type": "string", "maxLength": 8192 }
      }
    }
  }
}
